# SZU Valley · 环境变量 · Environment Variables
# 复制此文件为 .env 并填入真实值。
# Copy this file to .env and fill in real values.

# ---- 服务器 · Server ----
PORT=3001

# ---- Redis (位置缓存 · Position cache) ----
REDIS_URL=redis://localhost:6379

# ---- PostgreSQL (可选，当前用内存存储) ----
# Optional — currently using in-memory store
DATABASE_URL=postgresql://szu_valley:szu_valley_dev@localhost:5432/szu_valley
DB_USER=szu_valley
DB_PASSWORD=szu_valley_dev
DB_NAME=szu_valley

# ---- Vercel / 生产部署 · Production ----
# VERCEL_URL=your-app.vercel.app
